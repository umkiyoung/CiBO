# Ignore numpy binary files
*.npy
*.pkl
# ...except the run results the paper figures are plotted from
!baselines/results/**/*.npy
# Ignore the .vscode folder
.vscode/

# Ignore the wandb folder
wandb/

# Python cache files
__pycache__/
*.py[cod]

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Temporary files
*.log
*.tmp

*.bin
*.png